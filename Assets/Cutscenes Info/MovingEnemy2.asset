  m_Name: MovingEnemy2
  m_EditorClassIdentifier: 
  speakerSprites:
  - {fileID: 21300000, guid: d6225790f61e4c244832205e3c3f3776, type: 3}
  - {fileID: 21300000, guid: 4aa80d4eae0f0ed418709abae8605161, type: 3}
  - {fileID: 21300000, guid: c03553d42ea79554e9930fb21a174ecd, type: 3}
  - {fileID: 21300000, guid: a4093143c1b5b1c48b96db579f56cfeb, type: 3}
  sceneStills:
  - {fileID: 21300000, guid: 7396d3cc14a00904b8b9ec7b6419163e, type: 3}
  textColours:
  - {r: 0.011764706, g: 0.05490196, b: 0.25490198, a: 1}
  - {r: 0.6039216, g: 0.23137255, b: 0.011764706, a: 1}
  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "This company\u2019s gone too damn far man! It was one thing to do
      construction, but to litter the ocean with sharks?"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I can\u2019t believe they killed Bark! He was the first friend I made
      when I came here!"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "Oh, yeah\u2026 it\u2019s a real shame\u2026"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: He was always so kind, he loved everyone. I heard you were with him
      when he died. Please tell me, what was the last thing you guys talked about?
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "\u2026"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: I would love to hear the last words from someone with such a kind and
      open soul.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "Look man, I don\u2019t think you\u2019re gonna like what he said-"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Hey, no pressure to share. Everyone grieves differently. I\u2019ll
      always remember him as someone who loved everybody."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: Someone who thought all people were equal, and that we all belonged
      on the beach.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: He was my damn hero.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: I've gotta stop this company...
