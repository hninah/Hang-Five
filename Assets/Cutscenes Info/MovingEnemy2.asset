  speakerSprites:
  - {fileID: 21300000, guid: f3f229a9dc844814da08eab1e3dd6299, type: 3}
  - {fileID: 21300000, guid: 6afe3efb80fb72a40abd765373f6598b, type: 3}
  sceneStills:
  - {fileID: 21300000, guid: f95a98fe17bf9034082aad2bf7cebfd3, type: 3}
  directions:
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "This company\u2019s gone too damn far man, I can\u2019t believe they
      killed Bark! He was the first friend I made when I came here!"
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Yeah\u2026 it\u2019s a real shame\u2026"
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: 'I heard you were with him when he died. Please tell me, what was the
      last thing you guys talked about? '
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "\u2026"
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: I would love to hear the last words from someone with such a kind and
      open soul.
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Look man, I don\u2019t think you\u2019re gonna like what he said-"
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Hey, no pressure to share. Everyone grieves differently. I\u2019ll
      always remember him as someone who loved everybody."
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: Someone who thought all people were equal, and that we all belonged
      on the beach.
  - leftSpeaker: Surfer
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "How are we gonna stop these guys\u2026"
  nextCutscene: {fileID: 0}
