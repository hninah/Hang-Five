  m_Script: {fileID: 11500000, guid: a1e73c5106fe4f24f8c623b663cb8311, type: 3}
  m_Name: MovingEnemy2
  m_EditorClassIdentifier: 
  speakerSprites:
  - {fileID: 21300000, guid: f3f229a9dc844814da08eab1e3dd6299, type: 3}
  - {fileID: 21300000, guid: 6569f3bad81167743b09b2f983828fdb, type: 3}
  - {fileID: 21300000, guid: 6afe3efb80fb72a40abd765373f6598b, type: 3}
  - {fileID: 21300000, guid: 433f75f2fdaa60948b8f45ad0a1859d2, type: 3}
  sceneStills:
  - {fileID: 21300000, guid: 7396d3cc14a00904b8b9ec7b6419163e, type: 3}
  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "This company\u2019s gone too damn far man! It was one thing to do
      construction, but to litter the ocean with sharks?"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "I can\u2019t believe they killed Bark! He was the first friend I made
      when I came here!"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Oh, yeah\u2026 it\u2019s a real shame\u2026"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: 'He was always so kind, he loved everyone. I heard you were with him
      when he died. Please tell me, what was the last thing you guys talked about? '
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "\u2026"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: I would love to hear the last words from someone with such a kind and
      open soul.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Look man, I don\u2019t think you\u2019re gonna like what he said-"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Hey, no pressure to share. Everyone grieves differently. I\u2019ll
      always remember him as someone who loved everybody."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: Someone who thought all people were equal, and that we all belonged
      on the beach.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: He was my damn hero.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: I've gotta stop this company...
