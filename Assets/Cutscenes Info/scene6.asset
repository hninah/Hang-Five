  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: Ramesh! Ramesh!
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "What\u2019s up?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "There was this dude on the beach\u2026 I just saw his silhouette,
      and, I don\u2019t know I\u2019ve never seen him before, but-\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Calm down my friend, get to the point.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: Tricks Ramesh! You can do tricks on the wave!
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: "That's great, I\u2019m happy for you. I jus\u2019 hope you enjoy doing
      them before that damn Greenstachs company suspends all surfing-\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: "That\u2019s just it Ramesh! Every time I do a trick, I just\u2026
      I feel so\u2026 powerful\u2026 I have a newfound love for surfing."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: "Ramesh, baby, I\u2019m gonna stop these guys! "
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: More power to you brother.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: "No, more power to us! Before long, they\u2019ll be out of here, and
      it\u2019ll be endless Grapefruit Gunshots and Pickle Surprises for the both
      of us.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: "Sure, as long as you\u2019re paying.\r"
