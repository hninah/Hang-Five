    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: What happened to that southern charm-
