  textColours:
  - {r: 0.011764706, g: 0.05490196, b: 0.25490198, a: 1}
  - {r: 0.007843138, g: 0.25490198, b: 0.015686275, a: 1}
  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "So, do you like sharks?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "You got a lot of nerve showing your face around here!\r"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Yeah sorry about your friend with the fat face-\r"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "He wasn't my friend.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: Yeah well from what I gathered he was a good son. A damn patriot if
      you ask me.
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Y'know, I litter the ocean with wrecking balls, you don\u2019t stop
      surfing."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I send genetically engineered attack sharks into the sea, you don\u2019t
      stop surfing."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I spend hours of my own time getting seagulls familiar with your scent,
      training them to dive into waves and pluck your eyes out, yet you still won\u2019t
      stop!"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: I gotta admit, I admire your tenacity.
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "And I admire your melting skin. Get the hell off my beach bro, the
      shopping mall\u2019s not getting made."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Ha ha ha ha ha ha ha ha.
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "What\u2019s funny?"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Here I was thinking you were a cut above the rest, but you\u2019re
      no brighter than a piccadilly snowcone."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: Speak English!
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "You really think I\u2019d go through all this trouble just to build
      a mall?"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: What?! Explain-
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "I\u2019ll be seeing you again soon. Ha ha ha ha ha\u2026"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "Dammit! What\u2019s going on?\r"
