    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "What\u2019ll it be?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "Just the usual.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "I\u2019m afraid we\u2019re out of Jammin\u2019 Jamu at the moment.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "Alright, how about the Pineapple Powerslap?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: 'Out of that too.

'
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
