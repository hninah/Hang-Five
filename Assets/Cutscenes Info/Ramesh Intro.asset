  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Out.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: 'Grapefruit Gunshot?

'
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Out.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: 'Pickle Surprise?

'
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Out.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "Ramesh, what the hell's going on?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: "I\u2019m sorry my friend. This construction project has been a pain
      to the whole beach."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: "They\u2019re moving in, driving up prices, and getting rid of all
      my customers."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: "For the first time in 20 years, I can\u2019t afford to order more
      ingredients."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 4
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: Those rats. What do you have?
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: Baileys and Applejuice.
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: "It\u2019s bad enough they\u2019re taking over the beach, but now I
      can\u2019t get a drink?"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 4
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 0
    dialogue: These guys suck!
