  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "Had enough yet?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "We\u2019re just\u2026 warming up\u2026\r\r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "Why won\u2019t you quit? It\u2019s obviously over for you, why does
      this beach matter so much?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "These waves\u2026 they\u2019re in my blood man\u2026 you\u2019ll never
      understand\u2026 \r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "Oh yeah? It seems like I\u2019ve got plenty good understanding of
      the wave-\r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 3
    imgIdx: 0
    colourIdx: 1
    dialogue: Not again!
  - leftSpeaker: Uwe
    rightSpeaker: SUPER SHARK
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 4
    imgIdx: 0
    colourIdx: 2
    dialogue: "CHOMP\r"
  - leftSpeaker: Uwe
    rightSpeaker: Bark Shaits
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 4
    imgIdx: 0
    colourIdx: 0
    dialogue: "Heh\u2026 ha, ha ha ha ha! Good riddance.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 5
    imgIdx: 0
    colourIdx: 3
    dialogue: "Uwe! Are you alright?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 5
    imgIdx: 0
    colourIdx: 0
    dialogue: "I think\u2026 I think we did it\u2026\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 5
    imgIdx: 0
    colourIdx: 3
    dialogue: "You\u2019re losing a lot of blood!"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 5
    imgIdx: 0
    colourIdx: 0
    dialogue: "I wanna rest, Ramesh. Let the waves wash over my wounds. Let me watch
      the sunrise\u2026\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 7
    imgIdx: 0
    colourIdx: 3
    dialogue: "Uwe\u2026\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 7
    imgIdx: 0
    colourIdx: 0
    dialogue: "I always loved how the sunrise looked on this beach, Ramesh\u2026\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 6
    imgIdx: 0
    colourIdx: 3
    dialogue: "It\u2019s beautiful isn\u2019t it?\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 6
    imgIdx: 0
    colourIdx: 0
    dialogue: "Yes...\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 6
    imgIdx: 0
    colourIdx: 0
    dialogue: "Yes it... is...\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 6
    imgIdx: 0
    colourIdx: 3
    dialogue: "Goodnight, my friend.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 1
    rightSpeakerIdx: 6
    imgIdx: 0
    colourIdx: 0
    dialogue: "Goodnight... ol' buddy...\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 1
    rightSpeakerIdx: 7
    imgIdx: 0
    colourIdx: 3
    dialogue: "Dream of ocean waves, surfer boy.\r"
