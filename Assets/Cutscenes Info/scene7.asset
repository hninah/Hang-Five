  speakerSprites:
  - {fileID: 21300000, guid: d6225790f61e4c244832205e3c3f3776, type: 3}
  - {fileID: 21300000, guid: 4aa80d4eae0f0ed418709abae8605161, type: 3}
  - {fileID: 21300000, guid: e35f166c4aadd954294e63ea2d2e2236, type: 3}
  sceneStills:
  - {fileID: 21300000, guid: 7396d3cc14a00904b8b9ec7b6419163e, type: 3}
  textColours:
  - {r: 0.011764706, g: 0.05490196, b: 0.25490198, a: 1}
  - {r: 0.6039216, g: 0.23137255, b: 0.011764706, a: 1}
  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "Ramesh, what\u2019s going on. Why are you packing everything up?"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Well my friend, I\u2019m afraid this is the end of Ramesh\u2019s Tiki
      Tikka Juice Hut.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "What? No- that\u2019s- Ramesh, you can\u2019t leave!\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I\u2019m sorry, Uwe. But with all the construction the beach has dried
      up. We\u2019ve got no customers and barely any inventory.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "I\u2019m gonna stop them, you have to believe in me.\r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I hope you do, really. But I can\u2019t wait around. I\u2019ve got
      mouths to feed."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "Even if I take the risk and wait, the mall will have its own Juice
      bar that\u2019s gonna price me out."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "They\u2019re not building a mall!"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: Oh really? What are they building then?
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "I- I don\u2019t know yet. But I\u2019m gonna find out."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 1
    dialogue: "I wish you the best on your journey, but I can\u2019t wait any longer."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    colourIdx: 0
    dialogue: "Ramesh, I- I\u2019m sorry. \r"
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "Hey, it\u2019s ok. The endless summer had to end sometime. Goodbye
      Uwe."
  - leftSpeaker: Uwe
    rightSpeaker: Ramesh
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "I\u2019ll stop these guys! I promise.\r"
