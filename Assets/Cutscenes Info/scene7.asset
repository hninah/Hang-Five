  speakerSprites:
  - {fileID: 21300000, guid: f3f229a9dc844814da08eab1e3dd6299, type: 3}
  - {fileID: 21300000, guid: 6569f3bad81167743b09b2f983828fdb, type: 3}
  - {fileID: 21300000, guid: 23e5f2966eef2b24994544422b320027, type: 3}
