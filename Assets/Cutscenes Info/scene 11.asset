  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 1
    dialogue: "Why won\u2019t you die??!\r"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 7
    rightSpeakerIdx: 2
    imgIdx: 0
    colourIdx: 0
    dialogue: "I don\u2019t know, maybe you should ask Dick Nixon for a bigger defense
