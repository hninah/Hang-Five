  speakerSprites:
  - {fileID: 21300000, guid: 433f75f2fdaa60948b8f45ad0a1859d2, type: 3}
  - {fileID: 21300000, guid: d37d63abaf6c441429e37a5eb4319bf6, type: 3}
  - {fileID: 21300000, guid: 9f463d9f5893fc74abe8f1212c86005f, type: 3}
  - {fileID: 21300000, guid: 523f8ed98fdee314b9d10ae7639a52e6, type: 3}
  - {fileID: 21300000, guid: f3f229a9dc844814da08eab1e3dd6299, type: 3}
  - {fileID: 21300000, guid: 470dc91e34c80744e88dcae0e387fbc4, type: 3}
  sceneStills:
  - {fileID: 21300000, guid: f95a98fe17bf9034082aad2bf7cebfd3, type: 3}
  directions:
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 4
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "That was quite the tumble you took out there. Didn\u2019t I tell all
      you water hippies to skip town?"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 4
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Huh? I\u2019ve never seen you around here before, who the hell are
      you?"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 4
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: The name is Holden Greenstachs-
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 4
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: 'Greenstachs? As in Greenstachs Realty? '
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "You\u2019re the guys trying to turn Big Wave Beach into a shopping
      mall!"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    dialogue: "Heh heh heh\u2026 yeah, somethin\u2019 like that.\r\n"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 2
    imgIdx: 0
    dialogue: "Well I\u2019m not goin\u2019 nowhere jack! I\u2019m not gonna let
      you turn this place into some fat cat fart factory! Dig?"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: And pray tell how you plan on stopping me, coral muncher.
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "I\u2019m gonna surf, and keep surfing, and never stop surfing. Got
      it? These waves are in my blood, man. You\u2019re nothin\u2019."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 0
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "I admire the gumption, but you\u2019ll need a little more than that
      to-"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "Also, California Constitution, Article 4, Section 19, if I\u2019m
      out there surfing, you can\u2019t do any construction."
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: 'Look who has a brain! What a pleasant surprise. '
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 0
    isRightSpeaking: 1
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: "You might be smart for a west coaster, but if you think that\u2019ll
      actually stop me you might as well-"
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 5
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: 'Yeah like, whatever man.

'
  - leftSpeaker: Uwe
    rightSpeaker: Holden
    isLeftSpeaking: 1
    isRightSpeaking: 0
    leftSpeakerIdx: 3
    rightSpeakerIdx: 1
    imgIdx: 0
    dialogue: Cowabunga!
